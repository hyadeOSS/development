# Personal data and runtime state of an installation: never commit these.
# (config.json holds the password hash and the e-mail; session.key signs the sessions.)
# A file that is already tracked is NOT ignored by this list: remove it with `git rm --cached <file>` first.
config.json
system/config.json
system/session.key
system/keys.json
system/*.log
system/desktop/notes-db.json
system/spotify-token.json
.env

node_modules/

# Other accounts' home folders (Settings > Users): personal files, never pushed.
system/user-homes/

# The phone fork keeps its own accounts and sessions: never commit them either.
phone/config.json
phone/session.key
phone/user-homes/
phone/*.log
